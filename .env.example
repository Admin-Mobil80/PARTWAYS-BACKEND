# Copy to .env for local development. Leave keys empty to run in offline developer mode.
OPENAI_API_KEY=
# LLM_PROVIDER=offline   force the rule-based fallbacks even with a key
# LLM_MODEL=gpt-6.1-sol
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_ZERO_RETENTION=1   only if your ElevenLabs plan includes zero-retention mode
# Credits are bought with Stripe Checkout. Without a key, purchases are simulated test purchases.
# Use a test key (sk_test_…) until you are ready to take real payments.
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=whsec_…   webhook endpoint: <site>/api/stripe/webhook, event checkout.session.completed
# SITE_URL=https://your-domain   used for Stripe return links (defaults to the request origin)
# HR_ALLOWED_EMAILS=@yourcompany.com,person@example.com   optional: restrict who can sign up
# DEV_SHOW_OTP=1   show the sign-in code in the browser (local only)
